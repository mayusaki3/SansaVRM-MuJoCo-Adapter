{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayusaki3.github.io/SansaVRM-MuJoCo-Adapter/schemas/updated_extension_properties.schema.json",
  "title": "SansaVRM-MuJoCo-Adapter updated_extension_properties",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extension_properties"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "extension_properties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension_property"
      }
    }
  },
  "$defs": {
    "extension_property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension_property_id",
        "namespace",
        "target_type",
        "target_id",
        "property_role",
        "io_scope",
        "adapter_scope",
        "source_format",
        "source_raw",
        "normalized_value",
        "schema_ref",
        "diagnostics_ref",
        "conversion_report_ref"
      ],
      "properties": {
        "extension_property_id": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "target_type": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "property_role": {
          "type": "string",
          "minLength": 1
        },
        "io_scope": {
          "type": "string",
          "enum": [
            "mjcf",
            "adapter_artifact",
            "runtime_artifact",
            "both",
            "preserve_only",
            "unsupported",
            "source_raw"
          ]
        },
        "adapter_scope": {
          "type": "string",
          "minLength": 1
        },
        "source_format": {
          "type": "string",
          "minLength": 1
        },
        "source_raw": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "normalized_value": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "schema_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnostics_ref": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conversion_report_ref": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
