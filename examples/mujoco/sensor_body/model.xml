<mujoco model="sensor_body">
  <compiler angle="radian"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <worldbody>
    <light name="top_light" pos="0 0 2"/>
    <geom name="floor" type="plane" size="1 1 0.01"/>

    <body name="sensor_body" pos="0 0 0.2">
      <joint name="sensor_free_joint" type="free"/>
      <geom name="sensor_geom" type="box" size="0.05 0.05 0.05" mass="0.1"/>
      <site name="imu_site" pos="0 0 0.05" size="0.01"/>
    </body>
  </worldbody>

  <sensor>
    <accelerometer name="imu_accelerometer" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>
    <framepos name="imu_position" objtype="site" objname="imu_site"/>
  </sensor>
</mujoco>
